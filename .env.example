VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_ENV=production
VITE_APP_RELEASE=
# Khóa công khai VAPID (bản base64url 65 byte) — chạy `node scripts/generate-vapid-keys.mjs`
# để sinh; giá trị này KHÔNG bí mật, nhưng phải khớp VAPID_PRIVATE_JWK trên Edge secrets.
# Để trống = toàn bộ tính năng Web Push ẩn/trang thái "chưa cấu hình", app chạy bình thường.
VITE_VAPID_PUBLIC_KEY=
