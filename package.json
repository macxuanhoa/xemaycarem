{
  "name": "xe-crm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "scripts": {
    "ocr:assets": "node scripts/prepare-ocr-assets.mjs",
    "predev": "npm run ocr:assets",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run ocr:assets",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "node scripts/test-db.mjs",
    "test:e2e": "playwright test",
    "test:seed": "node supabase/tests/seed-smoke.mjs",
    "knowledge:system": "node scripts/build-system-docs.mjs",
    "knowledge:seed": "npm run knowledge:system && node scripts/build-knowledge-seed.mjs",
    "knowledge:check": "node scripts/build-system-docs.mjs --check && node scripts/build-knowledge-seed.mjs --check",
    "test:pwa": "node scripts/check-pwa.mjs",
    "backup:prod": "node scripts/backup-prod.mjs",
    "backup:verify": "node scripts/backup-verify.mjs",
    "backup:status": "node scripts/backup-status.mjs",
    "backup:integrity": "node scripts/backup-verify.mjs --integrity-only",
    "backup:weekly": "node scripts/backup-verify.mjs --if-due",
    "backup:export": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-export.ps1",
    "backup:zip": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-export.ps1",
    "staging:check": "node scripts/staging-check.mjs",
    "staging:build": "node scripts/staging-build.mjs",
    "format": "prettier --write src tests playwright.config.ts vitest.config.ts vite.config.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run knowledge:check && npm run test:db && npm run build",
    "db:types": "supabase gen types typescript --local > src/types/database.generated.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/supabase-js": "^2.57.4",
    "@tanstack/react-query": "^5.90.2",
    "@zxing/library": "^0.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.63.0",
    "react-router-dom": "^7.9.1",
    "tailwind-merge": "^3.3.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "pg": "^8.23.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "supabase": "2.120.0",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^4.1.11"
  }
}
