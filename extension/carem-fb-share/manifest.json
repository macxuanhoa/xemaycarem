{
  "manifest_version": 3,
  "name": "Cà Rem · Cầu đăng Facebook",
  "version": "1.0.1",
  "description": "Chuyển bài đăng từ CRM Cà Rem sang ô đăng bài Facebook: điền sẵn chữ, đính kèm ảnh xe, rồi DỪNG lại để người bán hàng tự kiểm tra và bấm Đăng. Không đọc cookie, không lấy token, không tự đăng.",
  "key": "",
  "permissions": ["tabs", "scripting"],
  "host_permissions": ["https://www.facebook.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://carem.vercel.app/*",
      "https://xemaycarem.vercel.app/*",
      "http://localhost:5173/*",
      "http://127.0.0.1:5173/*"
    ]
  }
}
